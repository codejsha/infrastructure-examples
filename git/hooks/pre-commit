#!/usr/bin/env bash
set -o errexit -o errtrace -o nounset -o pipefail
trap 'echo "[pre-commit] [FATAL] ${BASH_SOURCE[0]}:${LINENO}: status $?" >&2' ERR

readonly HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly ENV_FILE="${HOOKS_DIR}/.env"
readonly KEYWORDS_FILE="${HOOKS_DIR}/blocked_keywords.txt"

fn_log() { echo "[pre-commit] [INFO] $*"; }
fn_err() { echo "[pre-commit] [ERROR] $*" >&2; }
fn_die() { fn_err "$*"; exit 1; }

[[ -r ${ENV_FILE} ]] || fn_die "env file not readable: ${ENV_FILE}"
# shellcheck source=/dev/null
source "${ENV_FILE}"
: "${ENV_NAME:?required}"
: "${ENV_USER_NAME:?required}"
: "${ENV_USER_EMAIL:?required}"
: "${ENV_GPG_SIGNING_KEY:?required}"

export PATH="/opt/homebrew/bin:/usr/local/bin:${PATH}"
fn_log "environment: ${ENV_NAME}"
fn_log "repository root: $(git rev-parse --show-toplevel)"

failed=0

######################################################################

### blocked keywords

[[ -r ${KEYWORDS_FILE} ]] || fn_die "keywords file not readable: ${KEYWORDS_FILE}"
staged_diff="$(git diff --cached)"
while IFS= read -r keyword; do
    [[ -z ${keyword} ]] && continue
    if matches="$(grep -nF -- "${keyword}" <<<"${staged_diff}")"; then
        fn_err "staged changes contain a blocked keyword: ${keyword}"
        echo "${matches}" >&2
        failed=$((failed + 1))
    fi
done <"${KEYWORDS_FILE}"

######################################################################

### secret scan

command -v gitleaks >/dev/null || fn_die "gitleaks not found in PATH"
if ! gitleaks git --pre-commit --staged --redact --no-banner --log-level warn; then
    fn_err "gitleaks detected potential secrets in staged changes"
    failed=$((failed + 1))
else
    fn_log "Gitleaks scan passed"
fi

######################################################################

### identity + signing key

author_ident="$(git var GIT_AUTHOR_IDENT)"
author_name="${author_ident%% <*}"
author_email="${author_ident#*<}" && author_email="${author_email%%>*}"
committer_ident="$(git var GIT_COMMITTER_IDENT)"
committer_name="${committer_ident%% <*}"
committer_email="${committer_ident#*<}" && committer_email="${committer_email%%>*}"

if [[ ${author_name} != "${ENV_USER_NAME}" || ${author_email} != "${ENV_USER_EMAIL}" ]]; then
    fn_err "author '${author_name} <${author_email}>' != '${ENV_USER_NAME} <${ENV_USER_EMAIL}>'"
    failed=$((failed + 1))
fi
if [[ ${committer_name} != "${ENV_USER_NAME}" || ${committer_email} != "${ENV_USER_EMAIL}" ]]; then
    fn_err "committer '${committer_name} <${committer_email}>' != '${ENV_USER_NAME} <${ENV_USER_EMAIL}>'"
    failed=$((failed + 1))
fi

signing_key="$(git config user.signingkey || true)"
if [[ -z ${signing_key} ]]; then
    fn_err "no GPG key set for signing commits"
    failed=$((failed + 1))
else
    primary_fpr="$(gpg --list-keys --with-colons "${signing_key}" 2>/dev/null |
        awk -F: '/^fpr:/ {print $10; exit}' || true)"
    if [[ ${signing_key} != "${ENV_GPG_SIGNING_KEY}" && ${primary_fpr} != "${ENV_GPG_SIGNING_KEY}" ]]; then
        fn_err "signing key ${signing_key} (primary ${primary_fpr:-<none>}) != expected ${ENV_GPG_SIGNING_KEY}"
        failed=$((failed + 1))
    elif ! gpg --list-secret-keys "${signing_key}" >/dev/null 2>&1; then
        fn_err "secret key for ${signing_key} not in keyring; signing will fail"
        failed=$((failed + 1))
    else
        fn_log "GPG signing key matches the environment config"
    fi
fi

((failed == 0)) || fn_die "${failed} problem(s) found; commit rejected"
fn_log "pre-commit checks OK"
exit 0
